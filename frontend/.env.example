# MotorMate Frontend Production Environment Config Example

# The base URL of the production backend API
# Example: https://api.motormate.in/api
VITE_API_BASE_URL=PLACEHOLDER_REQUIRED

# Add any additional public frontend keys here
# VITE_RAZORPAY_KEY_ID=PLACEHOLDER_REQUIRED

